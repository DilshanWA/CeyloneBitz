generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role { CUSTOMER ADMIN }
enum OrderStatus { PENDING CONFIRMED PREPARING OUT_FOR_DELIVERY DELIVERED CANCELLED }
enum PaymentMethod { PAYHERE WHATSAPP }
enum PaymentStatus { PENDING PAID FAILED }

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
}
model Category {
  id    String     @id @default(cuid())
  name  String     @unique
  items FoodItem[]
}
model FoodItem {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Int      // whole LKR; format with 2 decimals for PayHere
  imageUrl    String   @default("")
  stock       Int      @default(0)
  available   Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([categoryId])
}
model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  customerName  String
  phone         String
  address       String
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  total         Int
  createdAt     DateTime      @default(now())
  items         OrderItem[]
  @@index([status])
}
// name/price are snapshots, so later menu edits never change past orders
model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId String?
  name       String
  qty        Int
  price      Int
}
